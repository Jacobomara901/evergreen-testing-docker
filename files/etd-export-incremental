#!/bin/bash
set -euo pipefail

export PGHOST="${PGHOST:-db}"
export PGPORT="${PGPORT:-5432}"
export PGUSER="${PGUSER:-evergreen}"
export PGPASSWORD="${PGPASSWORD:-evergreen}"
export PGDATABASE="${PGDATABASE:-evergreen}"

sql_dir=/usr/local/share/etd/sql
export_root=/exports
delta_dir="$export_root/marc_delta"
sync_interval="${EG_SYNC_INTERVAL:-120}"
overlap_seconds=60
keep_minutes=60

if ! [[ "$sync_interval" =~ ^[0-9]+$ ]]; then
    echo "etd-export: EG_SYNC_INTERVAL must be a whole number of seconds, not '$sync_interval'" >&2
    exit 1
fi

edit_window=$(( sync_interval + overlap_seconds ))

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

publish() {
    local source="$1"
    local name="$2"
    local staged="$delta_dir/.$name.tmp"
    install -m 644 "$source" "$staged"
    mv -f "$staged" "$delta_dir/$name"
}

prune_old_files() {
    find "$delta_dir" -maxdepth 1 -type f ! -name all_bib.ids -mmin "+$keep_minutes" -delete
}

mkdir -p "$delta_dir"
cd "$scratch"

psql -A -q -t -X -v ON_ERROR_STOP=1 -v "edit_window=$edit_window seconds" -f "$sql_dir/incremental.sql"

stamp="$(date +%Y%m%d%H%M%S)"

publish all_bib.ids "all_bib_$stamp.ids"
prune_old_files

if [ ! -s changed_bib.ids ]; then
    exit 0
fi

publish changed_bib.ids "incremental_changes_$stamp.ids"
echo "etd-export: $(wc -l < changed_bib.ids) changed bibs in incremental_changes_$stamp.ids"
