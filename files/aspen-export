#!/bin/bash
set -euo pipefail

export PGHOST="${PGHOST:-db}"
export PGPORT="${PGPORT:-5432}"
export PGUSER="${PGUSER:-evergreen}"
export PGPASSWORD="${PGPASSWORD:-evergreen}"
export PGDATABASE="${PGDATABASE:-evergreen}"

sql_dir=/usr/local/share/etd/sql
osrf_config=/openils/conf/opensrf_core.xml
exporter=/openils/bin/marc_export
export_root=/exports/aspen
split_lines=2500

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

mkdir -p "$export_root/marc" "$export_root/marc_delta" "$export_root/supplemental"
cd "$scratch"

echo "aspen-export: building the id lists and supplemental extracts"
psql -A -q -t -X -f "$sql_dir/aspen_full.sql"
psql -A -q -t -X -f "$sql_dir/aspen_daily.sql"

echo "aspen-export: $(wc -l < marc21.ids) marc21 bibs, $(wc -l < marcxml.ids) bibs with many copies"

: > all_bibs.mrc
split -l "$split_lines" marc21.ids chunk-
for chunk in chunk-*; do
    [ -e "$chunk" ] || continue
    echo "aspen-export: exporting $chunk"
    "$exporter" --encoding UTF-8 --check-leader --items --exclude-hidden \
        --852b circ_lib --config "$osrf_config" < "$chunk" >> all_bibs.mrc
done

write_large_bibs() {
    if [ ! -s marcxml.ids ]; then
        printf '<?xml version="1.0" encoding="UTF-8"?>\n<collection xmlns="http://www.loc.gov/MARC21/slim"/>\n' > large_bibs.xml
        return 0
    fi
    "$exporter" -f XML --encoding UTF-8 --check-leader --items --exclude-hidden \
        --852b circ_lib --config "$osrf_config" < marcxml.ids > large_bibs.xml
}

write_large_bibs

install -m 644 all_bibs.mrc "$export_root/marc/all_bibs.mrc"
install -m 644 large_bibs.xml "$export_root/marc/large_bibs.xml"
install -m 644 all_bib.ids "$export_root/marc_delta/all_bib.ids"
install -m 644 parts.csv "$export_root/supplemental/parts.csv"
install -m 644 barcode_active_dates.csv "$export_root/supplemental/barcode_active_dates.csv"
install -m 644 holds.csv "$export_root/supplemental/holds.csv"

echo "aspen-export: wrote $(du -sh "$export_root" | cut -f1) to $export_root"
