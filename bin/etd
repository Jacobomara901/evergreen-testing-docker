#!/bin/bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

env_file="${ETD_ENV:-}"
if [ -z "$env_file" ]; then
    env_file=.env
    if [ ! -f "$env_file" ]; then
        env_file=.env.example
    fi
fi

load_env_file() {
    local file="$1"
    if [ ! -f "$file" ]; then
        return 0
    fi
    local line key value
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line#"${line%%[![:space:]]*}"}"
        if [ -z "$line" ] || [ "${line#\#}" != "$line" ]; then
            continue
        fi
        line="${line#export }"
        if [ "${line%%=*}" = "$line" ]; then
            continue
        fi
        key="${line%%=*}"
        value="${line#*=}"
        if [ -n "${!key+x}" ]; then
            continue
        fi
        export "$key=$value"
    done < "$file"
}

load_env_file "$env_file"

compose() {
    local project="${COMPOSE_PROJECT_NAME:-egdev}"
    if [ -z "${ETD_PROXY_NETWORK:-}" ]; then
        docker compose -p "$project" "$@"
        return
    fi
    EG_INSTANCE="${EG_INSTANCE:-$project}" \
        docker compose -p "$project" -f docker-compose.yml -f compose/proxy.yml "$@"
}

usage() {
    cat <<USAGE
etd manages the evergreen-testing-docker stack.

Usage: bin/etd <command> [options]

Commands:
    up [-d]        Start the stack
    down [-v]      Remove the stack, -v also removes the database volume
    stop           Stop the containers
    start          Start stopped containers
    logs [-f]      Show the evergreen container logs
    shell          Bash in the evergreen container as opensrf
    psql           psql in the database container
    export         Regenerate the MARC export
    build          Build the images from this repository
    pull           Pull the published images
    push           Push the built images
    status         Show the container status
USAGE
}

command="${1:-}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command" in
    up) compose up "$@" ;;
    down) compose down "$@" ;;
    stop) compose stop "$@" ;;
    start) compose start "$@" ;;
    logs) compose logs "$@" evergreen ;;
    shell) compose exec --user opensrf evergreen bash ;;
    psql) compose exec --env PGPASSWORD=evergreen db psql -U evergreen -d evergreen "$@" ;;
    export) compose exec --user opensrf evergreen etd-export ;;
    build) compose build "$@" ;;
    pull) compose pull "$@" ;;
    push) compose push "$@" ;;
    status) compose ps "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "etd: unknown command '$command'" >&2; usage >&2; exit 1 ;;
esac
